# AIDA Backend Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration (REQUIRED for AI-powered analysis)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model Provider (default: openai)
# Currently only 'openai' is supported
AIDA_MODEL_PROVIDER=openai

# OpenAI Model (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-4, gpt-3.5-turbo
AIDA_MODEL=gpt-4o-mini

# Default output directory for artifacts (default: artifacts)
AIDA_OUTPUT=artifacts

# NOTE: No hardcoded fallbacks are used in this application.
# Proper AI configuration is required to generate genuine data insights.
